    {
      "type": "stat",
      "title": "Replication-slot guardrail",
      "description": "Per-slot status from normalized collector metrics. LOST or inactive physical slots require operator review; never delete pg_wal files manually.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "pg_replication_slot_active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "active {{instance}} {{slot_name}}"
        },
        {
          "expr": "pg_replication_slot_wal_lost",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "WAL lost {{instance}} {{slot_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO COLLECTOR",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^WAL lost/"
            },
            "properties": [
              {
