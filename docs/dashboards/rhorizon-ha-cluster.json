{
  "uid": "rhorizon-ha-cluster",
  "title": "rhorizon -- HA cluster (API + Database HA)",
  "tags": [
    "rhorizon",
    "ha",
    "cluster",
    "database-ha",
    "patroni",
    "pgha",
    "postgres"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(rhorizon_vault_sealed, instance)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node_instance",
        "label": "PostgreSQL node exporter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_filesystem_size_bytes, instance)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pgdata_mountpoint",
        "label": "PGDATA / pg_wal filesystem mountpoint (regex)",
        "type": "textbox",
        "query": "/",
        "current": {
          "text": "/",
          "value": "/"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Database HA (provider-neutral: Patroni / pgha)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 16
    },
    {
      "type": "stat",
      "title": "Database HA",
      "description": "Provider-neutral status from /cluster/health. Green=verified healthy, orange=degraded/transitional, red=verified unhealthy, black/UNKNOWN=no provider signal. Provider is selected by RH_DATABASE_HA_PROVIDER (Patroni or BSD pgha).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "rhorizon_cluster_component{component=\"database_ha\",instance=~\"$instance\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "fixed",
            "fixedColor": "black"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "RED",
                  "color": "red"
                },
                "0.5": {
                  "text": "DEGRADED",
                  "color": "orange"
                },
                "1": {
                  "text": "GREEN",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 17
    },
    {
