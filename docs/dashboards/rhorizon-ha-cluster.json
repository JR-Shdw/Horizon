    {
      "type": "stat",
      "title": "Failover / K7 health gate",
      "description": "SAFE only when database, database_ha, and application cluster samples are all present and green for an API instance. Missing/grey components render black/UNKNOWN.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "min by (instance) (rhorizon_cluster_component{component=~\"database|database_ha|cluster\",instance=~\"$instance\"}) and on (instance) (count by (instance) (rhorizon_cluster_component{component=~\"database|database_ha|cluster\",instance=~\"$instance\"}) == 3)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
