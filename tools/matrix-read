"""matrix-read, read Matrix messages with credentials pulled from rhorizon.

Read-side companion to matrix-notify: fetches new `m.room.message` events
since the last call, prints them, persists the sync token so the next
call resumes where this one left off. Stdlib only (Python 3.10+).

USAGE
-----
    # One-shot, print every new message since the last invocation
    matrix-read

    # Daemon, long-poll, stream messages as they arrive (Ctrl-C to stop)
    matrix-read --watch

    # JSON output (one event per line), pipe-friendly for jq / scripts
    matrix-read --format json

    # First run: discard any saved cursor and start "from now"
    matrix-read --reset

    # Backfill, fetch the last N messages from history (uses /messages,
    # not /sync), independent of the sync cursor
    matrix-read --backfill 20

CONFIGURATION
-------------
Same `~/.config/rhorizon/matrix.conf` as matrix-notify (homeserver,
token_secret, room_secret). The sync cursor lives at
`~/.config/rhorizon/matrix.state` (mode 0600, just the next_batch
token).

EXIT CODES
----------
  0  normal exit (one-shot mode = printed any new events; watch mode = SIGINT)
  1  bad CLI input
  2  config / vault token problem
  3  vault unreachable or returned an error
  4  matrix unreachable or returned an error
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CONFIG_DIR = Path(
    os.environ.get("RHORIZON_CONFIG_DIR", "~/.config/rhorizon")
).expanduser()
TOKEN_PATH = CONFIG_DIR / "token"
URL_PATH = CONFIG_DIR / "url"
CONF_PATH = CONFIG_DIR / "matrix.conf"
STATE_PATH = CONFIG_DIR / "matrix.state"

DEFAULTS = {
    "homeserver": "https://matrix.org",
    "token_secret": "matrix-token",
    "room_secret": "matrix-room",
}


def _die(msg: str, code: int = 2) -> None:
    print(f"matrix-read: {msg}", file=sys.stderr)
    sys.exit(code)


def _read_vault_token() -> str:
    if not TOKEN_PATH.exists():
        _die(f"no vault token at {TOKEN_PATH}")
    if TOKEN_PATH.stat().st_mode & 0o077:
        _die(f"{TOKEN_PATH} permissions too open; chmod 0600")
    return TOKEN_PATH.read_text().strip()


def _read_vault_url() -> str:
    if URL_PATH.exists():
        return URL_PATH.read_text().strip()
    return os.environ.get("RHORIZON_VAULT_URL", "https://vault.example.com")


def _read_conf() -> dict[str, str]:
    out = dict(DEFAULTS)
    if not CONF_PATH.exists():
        return out
    for raw in CONF_PATH.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        out[k.strip()] = v.strip()
    return out


def _vault_get(vault_url: str, vault_token: str, secret_name: str) -> str:
    # Accept `namespace/name` to disambiguate same-name secrets across
    # namespaces, the API returns 409 ambiguous otherwise. Same
    # convention as git-credential-rhorizon and rh-fetch/rh-watch.
    if "/" in secret_name:
        namespace, _, name = secret_name.partition("/")
        qs = f"?namespace={urllib.parse.quote(namespace)}"
    else:
        name = secret_name
        qs = ""
    url = f"{vault_url.rstrip('/')}/api/v1/vault/secrets/{name}{qs}"
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {vault_token}"}
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.load(resp)["value"]
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        _die(f"vault returned {e.code} for {secret_name}: {body}", 3)
    except urllib.error.URLError as e:
        _die(f"vault unreachable at {url}: {e}", 3)
    return ""


def _matrix_sync(
    homeserver: str,
    matrix_token: str,
    room_id: str,
    since: str | None,
    timeout_ms: int,
) -> dict:
    """GET /_matrix/client/v3/sync, server-filtered to just message events
    in the target room, no presence/account-data/state noise."""
    filter_obj = {
        "room": {
            "rooms": [room_id],
            "timeline": {"limit": 50, "types": ["m.room.message"]},
            "ephemeral": {"types": []},
            "state": {"types": []},
            "account_data": {"types": []},
        },
        "presence": {"types": []},
        "account_data": {"types": []},
    }
    params: dict[str, str] = {
        "filter": json.dumps(filter_obj, separators=(",", ":")),
        "timeout": str(timeout_ms),
    }
    if since:
        params["since"] = since
    url = (
        f"{homeserver.rstrip('/')}/_matrix/client/v3/sync?"
        f"{urllib.parse.urlencode(params)}"
    )
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {matrix_token}"}
    )
    try:
        # Sync timeout is server-side; client-side we wait a bit longer.
        with urllib.request.urlopen(req, timeout=(timeout_ms / 1000) + 30) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        _die(f"matrix returned {e.code}: {body}", 4)
    except urllib.error.URLError as e:
        _die(f"matrix unreachable at {url}: {e}", 4)
    return {}


def _matrix_messages(
    homeserver: str,
    matrix_token: str,
    room_id: str,
    limit: int,
) -> list[dict]:
    """GET /_matrix/client/v3/rooms/{room}/messages, backfill recent
    history. Independent of the sync cursor."""
    safe_room = urllib.parse.quote(room_id, safe="")
    params = {
        "dir": "b",  # backwards from the latest
        "limit": str(limit),
        "filter": json.dumps({"types": ["m.room.message"]}, separators=(",", ":")),
    }
    url = (
        f"{homeserver.rstrip('/')}/_matrix/client/v3/rooms/"
        f"{safe_room}/messages?{urllib.parse.urlencode(params)}"
    )
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {matrix_token}"}
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        _die(f"matrix returned {e.code}: {body}", 4)
    except urllib.error.URLError as e:
        _die(f"matrix unreachable at {url}: {e}", 4)
        return []
    # /messages returns events in reverse chronological order when dir=b;
    # flip them so the caller sees oldest-first.
    return list(reversed(data.get("chunk", [])))


def _extract_room_events(sync: dict, room_id: str) -> list[dict]:
    """Pull out the timeline events for our specific room from a /sync."""
    rooms = sync.get("rooms", {}).get("join", {})
    return rooms.get(room_id, {}).get("timeline", {}).get("events", [])


def _format_event(event: dict, fmt: str) -> str:
    if fmt == "json":
        return json.dumps(event, ensure_ascii=False, separators=(",", ":"))
    # text mode: [iso-time] sender: body
    ts = event.get("origin_server_ts")
    if isinstance(ts, int):
        when = datetime.fromtimestamp(ts / 1000, tz=timezone.utc).isoformat(
            timespec="seconds"
        )
    else:
        when = "?"
    sender = event.get("sender", "?")
    body = event.get("content", {}).get("body", "")
    # Inline newlines so each event stays on one line in text mode
    body = body.replace("\n", " ⏎ ")
    return f"[{when}] {sender}: {body}"


def _read_state() -> str | None:
    if not STATE_PATH.exists():
        return None
    s = STATE_PATH.read_text().strip()
    return s or None


def _write_state(token: str) -> None:
    STATE_PATH.write_text(token + "\n")
    STATE_PATH.chmod(0o600)


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="matrix-read",
        description="Read Matrix messages with credentials from rhorizon.",
    )
    p.add_argument(
        "--watch",
        action="store_true",
        help="Long-poll mode: keep streaming new events until SIGINT.",
    )
    p.add_argument(
        "--format",
        choices=("text", "json"),
        default="text",
        help="text (default, one line per event) or json (one JSON object per line).",
    )
    p.add_argument(
        "--reset",
        action="store_true",
        help=(
            "Discard the saved sync cursor and start from now. The first "
            "call after --reset shows nothing, subsequent calls show new events."
        ),
    )
    p.add_argument(
        "--backfill",
        type=int,
        metavar="N",
        help=(
            "Fetch the last N messages from history (uses /messages instead of "
            "/sync, doesn't touch the saved cursor). Useful to scroll back."
        ),
    )
    p.add_argument(
        "--timeout",
        type=int,
        default=30,
        help="Seconds to long-poll on each /sync call when --watch (default 30).",
    )
    p.add_argument("--room", help="Override the resolved room ID.")
    p.add_argument(
        "--token",
        help="Override the resolved Matrix token (test-mode; defeats the dogfood).",
    )
    p.add_argument("--homeserver", help="Override homeserver URL.")
    p.add_argument(
        "--token-secret",
        help="rhorizon secret name holding the Matrix access token.",
    )
    p.add_argument(
        "--room-secret",
        help="rhorizon secret name holding the target room ID.",
    )
    return p


def _resolve_creds(args) -> tuple[str, str, str]:
    """Returns (homeserver, matrix_token, room_id)."""
    conf = _read_conf()
    homeserver = (
        args.homeserver or os.environ.get("MATRIX_HOMESERVER") or conf["homeserver"]
    )
    if args.token and args.room:
        return homeserver, args.token, args.room
    vault_url = _read_vault_url()
    vault_token = _read_vault_token()
    token_secret = (
        args.token_secret
        or os.environ.get("MATRIX_TOKEN_SECRET")
        or conf["token_secret"]
    )
    room_secret = (
        args.room_secret or os.environ.get("MATRIX_ROOM_SECRET") or conf["room_secret"]
    )
    matrix_token = args.token or _vault_get(vault_url, vault_token, token_secret)
    room_id = args.room or _vault_get(vault_url, vault_token, room_secret)
    return homeserver, matrix_token, room_id


def main() -> int:
    args = _build_parser().parse_args()
    homeserver, matrix_token, room_id = _resolve_creds(args)

    if args.backfill is not None:
        if args.backfill < 1 or args.backfill > 1000:
            _die("--backfill must be between 1 and 1000", 1)
        events = _matrix_messages(homeserver, matrix_token, room_id, args.backfill)
        for e in events:
            print(_format_event(e, args.format), flush=True)
        return 0

    since = None if args.reset else _read_state()

    # Initial sync: short timeout, just to drain anything pending and capture
    # the cursor.
    initial_timeout_ms = 0 if not args.watch else 0
    data = _matrix_sync(homeserver, matrix_token, room_id, since, initial_timeout_ms)
    next_batch = data.get("next_batch", "")
    for e in _extract_room_events(data, room_id):
        print(_format_event(e, args.format), flush=True)
    if next_batch:
        _write_state(next_batch)

    if not args.watch:
        return 0

    # Watch mode, long-poll forever
    try:
        while True:
            data = _matrix_sync(
                homeserver,
                matrix_token,
                room_id,
                next_batch,
                args.timeout * 1000,
            )
            next_batch = data.get("next_batch", next_batch)
            for e in _extract_room_events(data, room_id):
                print(_format_event(e, args.format), flush=True)
            if next_batch:
                _write_state(next_batch)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
