# K7 24h random HA chaos/load configuration.
#
# Copy with:
#   make chaos-k7-init
#
# Then run:
#   make chaos-k7-24h-detached
#   make chaos-k7-status

# Cluster VIP / load balancer. This must stay reachable during 1-node faults.
RH_URL=https://rhorizon.lab:443

# Token needs admin:w, secrets:rw, audit read access, and any notification or
# dynamic-secret scopes you enable below. Prefer a 0400 file over inline token.
RH_TOKEN_FILE=$HOME/.rhorizon/chaos-token-admin-w
# RH_TOKEN=rh_...

# TLS verification. Set CHAOS_INSECURE_TLS=1 only for an isolated lab.
RH_CA_FILE=$HOME/.rhorizon/cluster-ca.pem
# CHAOS_INSECURE_TLS=1

# Node UUID -> node control host. Required. The host value is passed to
# CHAOS_DOWN_CMD, CHAOS_UP_CMD, CHAOS_NODE_RECOVER_CMD, or Docker-over-SSH.
#
# Example file:
# {
#   "0f5c...": "mgr-1.lab",
#   "1c8a...": "mgr-2.lab",
#   "2b9b...": "mgr-3.lab"
# }
CHAOS_HOST_BY_UUID=/tmp/rhorizon-ha-hosts.json

# Direct node URLs for survivor proof while two nodes are down. Required when
# CHAOS_TWO_DOWN_PROB_PERCENT is non-zero (the default).
#
# Example file:
# {
#   "0f5c...": "https://mgr-1.lab:443",
#   "1c8a...": "https://mgr-2.lab:443",
#   "2b9b...": "https://mgr-3.lab:443"
# }
CHAOS_URL_BY_UUID=/tmp/rhorizon-ha-urls.json
# CHAOS_NODE_URL_TEMPLATE=https://{host}:443

# Strict 24h workload/fault window. Cleanup and final evidence collection run
# after this window and can add extra wall-clock time.
CHAOS_DURATION_SECS=86400
CHAOS_LOAD_PROFILE=medium
CHAOS_NAMESPACE=chaos-k7
CHAOS_EXPECTED_WORKERS_PER_NODE=5

# K7 refuses to start unless /cluster/health reports a writable database and
# three fully converged database-HA members. Configure RH_DATABASE_HA_PROVIDER
# and RH_DATABASE_HA_STATUS_URLS on the API nodes; grey/unknown orchestration is
# intentionally rejected. Normal replica-lag tolerance defaults to 16 MiB:
# RH_DATABASE_HA_MAX_REPLICA_LAG_BYTES=16777216

# Bounded final readback. Set 0 only when the additional time needed to read
# every successful write is acceptable.
CHAOS_FINAL_VERIFY_LIMIT=10000

# Random fault cadence. Defaults are medium/high-profile aware; override only if
# you need tighter or wider chaos spacing.
# CHAOS_FAULT_MIN_INTERVAL_SECS=300
# CHAOS_FAULT_MAX_INTERVAL_SECS=1200
# CHAOS_TWO_DOWN_PROB_PERCENT=25
# CHAOS_CONVERGENCE_WAIT_SECS=180

# Bounded disk/IO pressure. The rhorizon_ha K7 wrapper enables this by
# default and writes 1 or 2 GiB to a dedicated /var/tmp file on one live node.
# The file is removed immediately after fdatasync; cleanup also removes only
# files carrying this run's validated ID. A 4 GiB free-space reserve is
# enforced on the node before every write.
# CHAOS_DISK_PRESSURE=1
# CHAOS_DISK_PRESSURE_MIN_GIB=1
# CHAOS_DISK_PRESSURE_MAX_GIB=2
# CHAOS_DISK_PRESSURE_MIN_INTERVAL_SECS=600
# CHAOS_DISK_PRESSURE_MAX_INTERVAL_SECS=1800
# Kill one authenticated follower after the first successful pressure cycle,
# then require the configured worker count to recover. The command receives
# {uuid}, {host}, {url}, and {pid}. Leave disabled without a trusted controller.
# CHAOS_WORKER_KILL_AFTER_PRESSURE=0
# CHAOS_WORKER_KILL_CMD='ssh operator@{host} sudo kill -KILL {pid}'

# Default node control is Docker-over-SSH using this label.
CHAOS_API_CONTAINER_LABEL=rhorizon-api
CHAOS_SSH_USER=root
# CHAOS_SSH_IDENTITY_FILE=$HOME/.ssh/rhorizon-lab_ed25519
# CHAOS_CAPTURE_DOCKER_LOGS=0  # bare-metal/systemd lab

# PVE / power-control mode. Replace the commands with your lab's VM IDs or
# wrappers. Templates receive {uuid}, {host}, and {url}.
# CHAOS_DOWN_CMD='ssh pve1 qm stop {host}'
# CHAOS_UP_CMD='ssh pve1 qm start {host}'
# CHAOS_NODE_RECOVER_CMD='make unseal RH={host}'
# CHAOS_NODE_CHECK_CMD='ssh {host} systemctl is-active rhorizon-api'

# Optional integration load. Leave disabled unless the backing services/channels
# are safe to exercise for 24h.
# CHAOS_DYNAMIC_ENGINE_ID=
# CHAOS_DYNAMIC_ROLE_NAME=
# CHAOS_ALERT_CHANNEL_ID=

# Failure policy. Default accepts PASS_TRANSIENT_ERRORS when final integrity is
# clean; set to 1 to fail on any transient probe/workload error.
# CHAOS_FAIL_ON_WORKLOAD_ERRORS=1
