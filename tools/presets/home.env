# home - default preset. Single worker, keys held in-process (no Shamir/RPC),
# bound to localhost. Personal/laptop use. Total footprint ~600 MB.
RHORIZON_WORKERS=1
RHORIZON_API_MEM=768M
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE=256MB
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_MEM=512M
RHORIZON_FRONTEND_MEM=64M
