# heavy - high concurrency. 10 workers serve HTTP and hold no key material;
# a standalone Rust custodian quorum holds the Shamir shares. 4-of-7 custody
# quorum survives 3 lost custodians. Larger PG pool. Total footprint ~2.7 GB.
RHORIZON_WORKERS=10

# Key custody. separated + rust puts the Shamir shares in a fixed pool of small
# mlock'd daemons (~4 MB each) instead of in the API workers, which become
# disposable. Threshold is left implicit: 0 selects the majority.
#
# Slots are read AT LAUNCH and a pool that already holds shares will not start
# under a different shape -- the launcher resolves the shape it actually holds
# and logs the difference rather than obeying blindly. So switching tier on a
# LIVE deployment does not reshape its custody quorum; it keeps the one it has.
#
# Shares are RAM-only with the default state provider. After a full host
# restart the vault returns sealed, and the master password rebuilds the pool.
# The key directory contains transport identities, not recoverable shares;
# protect it and back it up with the database for interrupted reshare recovery.
RHORIZON_CUSTODY_MODE=separated
RHORIZON_CUSTODY_BACKEND=rust
RHORIZON_RUST_CUSTODIAN_SLOTS=7
RHORIZON_API_MEM=2560M
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE=1536MB
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_MEM=2G
RHORIZON_FRONTEND_MEM=128M
