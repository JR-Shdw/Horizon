"""rhorizon git-credential helper (Backlog #5).

Lets git pull credentials from the rhorizon vault instead of storing them
in `.git/config` URLs or other plaintext caches. Eats our own dogfood:
the project that ships rhorizon is the first to depend on it for its
remote auth.

For a complete adoption walkthrough (vault setup, token minting, mass
URL rewrite for existing repos, validation), see:
    tools/git-credential-rhorizon.examples/README.md

INSTALLATION (quick)
--------------------
1. Mint a vault token with `secrets:r` scoped to the gitea creds:

       curl -X POST $VAULT_URL/api/v1/vault/tokens/ \\
            -H "Authorization: Bearer $ADMIN_TOKEN" \\
            -H "Content-Type: application/json" \\
            -d '{"name":"git-credential-helper",
                 "permissions":{"secrets":"r","namespaces":["git"]}}'

2. Save the bootstrap token mode 0600:

       umask 077
       echo 'rh_xxxxxxxxxxxxxxxxxxxxxxxxxxxx' > ~/.config/rhorizon/token
       echo 'https://vault.example.com' > ~/.config/rhorizon/url

3. Install the helper somewhere on $PATH:

       sudo install -m 0755 git-credential-rhorizon /usr/local/bin/

4. Configure git globally:

       git config --global credential.helper rhorizon

5. Strip the token out of any existing remote URLs:

       git remote set-url origin https://github.com/JR-Shdw/Horizon.git

USAGE
-----
git-credential calls this helper with one of three operations on argv[1]:
  - get  , read attributes from stdin, write username+password to stdout
  - store, git asks us to remember a credential. We're a read-only proxy,
            so we ignore.
  - erase, git wants us to forget. Same, ignored.

Lookup mapping (host → vault secret name) is in ~/.config/rhorizon/git-map
as a TOML-ish key=value file:

  gitea.example.com = git/gitea-api-token

Falling back to a default of `git/<hostname>-api-token` if no entry.
The leading `git/` is a namespace; tokens for the helper should be
scoped to namespaces=["git"].

DEPENDENCIES (operator's machine):
    Python 3.10+ stdlib only, no third-party requirements
"""

from __future__ import annotations

import logging
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

# RH_* is the canonical env prefix product-wide; RHORIZON_* stays as a
# deprecated alias so existing setups keep working.
CONFIG_DIR = Path(
    os.environ.get("RH_CONFIG_DIR")
    or os.environ.get("RHORIZON_CONFIG_DIR")
    or "~/.config/rhorizon"
).expanduser()
TOKEN_PATH = CONFIG_DIR / "token"
URL_PATH = CONFIG_DIR / "url"
MAP_PATH = CONFIG_DIR / "git-map"
DEFAULT_URL = "https://vault.example.com"

log = logging.getLogger("git-credential-rhorizon")
logging.basicConfig(
    level=os.environ.get("RH_LOG_LEVEL")
    or os.environ.get("RHORIZON_LOG_LEVEL")
    or "WARNING",
    format="%(name)s: %(message)s",
)


def _read_input() -> dict[str, str]:
    """Parse the git-credential key=value stream from stdin until EOF or
    blank line. Git uses LF-separated key=value pairs."""
    attrs: dict[str, str] = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        if "=" not in line:
            continue
        k, _, v = line.partition("=")
        attrs[k] = v
    return attrs


def _read_token() -> str:
    if not TOKEN_PATH.exists():
        log.error(
            "no rhorizon token at %s, see installation notes in the script header",
            TOKEN_PATH,
        )
        sys.exit(2)
    # Defensive permission check, refuse to run if the file is world/group-readable.
    st = TOKEN_PATH.stat()
    if st.st_mode & 0o077:
        log.error(
            "%s permissions too open (mode=%o); chmod 0600",
            TOKEN_PATH,
            st.st_mode & 0o777,
        )
        sys.exit(2)
    return TOKEN_PATH.read_text().strip()


def _read_vault_url() -> str:
    if URL_PATH.exists():
        return URL_PATH.read_text().strip()
    return (
        os.environ.get("RH_VAULT_URL")
        or os.environ.get("RHORIZON_VAULT_URL")
        or DEFAULT_URL
    )


def _load_map() -> dict[str, str]:
    """Parse the host → secret name map. Lines like `host = secret/path`,
    `#`-comments allowed, blanks ignored."""
    if not MAP_PATH.exists():
        return {}
    mapping: dict[str, str] = {}
    for raw in MAP_PATH.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            continue
        k, _, v = line.partition("=")
        mapping[k.strip()] = v.strip()
    return mapping


def _resolve_secret_name(host: str) -> str:
    mapping = _load_map()
    if host in mapping:
        return mapping[host]
    # Default: git/<hostname-with-dots-as-dashes>-api-token
    safe = host.replace(".", "-")
    return f"git/{safe}-api-token"


def _fetch_secret(vault_url: str, token: str, secret_name: str) -> str:
    """GET /api/v1/vault/secrets/{name}?namespace={ns} → return value field.

    Accepts secret_name in either form :
      - "namespace/name" (recommended ; comes from git-map convention)
      - "name" alone (falls back to whatever default the vault applies)
    """
    import urllib.parse as _up

    if "/" in secret_name:
        namespace, _, name = secret_name.partition("/")
    else:
        namespace, name = None, secret_name
    qs = f"?namespace={_up.quote(namespace)}" if namespace else ""
    url = f"{vault_url.rstrip('/')}/api/v1/vault/secrets/{_up.quote(name)}{qs}"
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {token}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            import json as _json

            data = _json.load(resp)
            return data["value"]
    except urllib.error.HTTPError as e:
        log.error(
            "vault returned %d for %s: %s",
            e.code,
            secret_name,
            e.read().decode(),
        )
        sys.exit(3)
    except urllib.error.URLError as e:
        log.error("vault unreachable at %s: %s", url, e)
        sys.exit(3)


def _op_get() -> int:
    attrs = _read_input()
    host = attrs.get("host")
    if not host:
        log.error("git-credential 'get' missing host attribute")
        return 1

    token = _read_token()
    vault_url = _read_vault_url()
    secret_name = _resolve_secret_name(host)

    log.info("fetching %s for host=%s", secret_name, host)
    password = _fetch_secret(vault_url, token, secret_name)

    # Username defaults to the entry in attrs if git already knows one,
    # otherwise we use the local OS user (matches gitea convention).
    username = attrs.get("username") or os.environ.get("USER", "git")

    print(f"protocol={attrs.get('protocol', 'https')}")
    print(f"host={host}")
    print(f"username={username}")
    print(f"password={password}")
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        log.error("usage: git-credential-rhorizon <get|store|erase>")
        return 1
    op = sys.argv[1]
    if op == "get":
        return _op_get()
    if op in ("store", "erase"):
        # Read-only proxy, git's request to store/erase is a no-op.
        # Drain stdin so git doesn't get a SIGPIPE.
        sys.stdin.read()
        return 0
    log.error("unknown operation: %s", op)
    return 1


if __name__ == "__main__":
    sys.exit(main())
