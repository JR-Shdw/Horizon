FROM docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS builder

WORKDIR /build

# SOURCE_DATE_EPOCH normalises file mtimes inside the layer for
# reproducibility. Honoured by BuildKit (>= 0.11) globally on the layer,
# and by pip / setuptools / maturin at the file level.
ARG SOURCE_DATE_EPOCH=315532800
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Build dependencies (libsodium for pynacl, libldap + gcc for bonsai)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libsodium-dev libldap-dev libsasl2-dev gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt .
COPY api/app/dynamic_engines/mysql/requirements.txt /dynamic-requirements/mysql.txt
COPY api/app/dynamic_engines/redis/requirements.txt /dynamic-requirements/redis.txt
COPY api/app/dynamic_engines/cassandra/requirements.txt /dynamic-requirements/cassandra.txt
# --require-hashes: refuse any wheel whose hash isn't in requirements.txt.
# requirements.txt is generated by `pip-compile --generate-hashes` from
# requirements.in (loose constraints). Any drift on PyPI -> build fails.
RUN pip install --no-cache-dir --prefix=/install --require-hashes -r requirements.txt

# Protocol drivers that are not used by the core have isolated, hash-locked
# dependency sets. Defaults build the complete native catalog. A hardened image
# can physically omit unused drivers, for example:
#   --build-arg RH_DYNAMIC_ENGINE_DEPS="redis"
# The runtime INI must enable only modules present in the resulting image.
ARG RH_DYNAMIC_ENGINE_DEPS="mysql redis cassandra"
RUN set -eu; \
    for module in ${RH_DYNAMIC_ENGINE_DEPS}; do \
        case "${module}" in \
            mysql|redis|cassandra) ;; \
            *) echo "unknown dynamic engine dependency: ${module}" >&2; exit 1 ;; \
        esac; \
        pip install --no-cache-dir --prefix=/install --require-hashes \
            -r "/dynamic-requirements/${module}.txt"; \
    done


# -- Rust extension builder (secure memory: mlock + zeroize) --
FROM docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS rust-builder

# Pin the rustup-init BINARY (not just the install script) by sha256, fetched
# directly from static.rust-lang.org. Upstream publishes no GPG/cosign signature
# for rustup-init, so the sha256 is the verifiable anchor: a CDN compromise or
# MitM that swaps the binary fails the build instead of running a tampered
# toolchain. Arch-aware because this image is built multi-platform (amd64 +
# arm64); TARGETARCH is set by buildx, with a dpkg fallback for classic builds.
# Bump RUSTUP_VERSION + both hashes together on a rustup bump (hashes from
# .../<triple>/rustup-init.sha256).
ARG TARGETARCH
ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_INIT_SHA256_AMD64=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
ARG RUSTUP_INIT_SHA256_ARM64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gcc libc6-dev && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
      amd64) RTRIPLE=x86_64-unknown-linux-gnu;  RSHA="$RUSTUP_INIT_SHA256_AMD64" ;; \
      arm64) RTRIPLE=aarch64-unknown-linux-gnu; RSHA="$RUSTUP_INIT_SHA256_ARM64" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac && \
    curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RTRIPLE}/rustup-init" && \
    echo "${RSHA}  /tmp/rustup-init" | sha256sum -c - && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --default-toolchain stable --profile minimal && \
    rm /tmp/rustup-init && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip install --no-cache-dir maturin

WORKDIR /build
COPY api/rust/ .

# Reproducible build flags:
# - --remap-path-prefix=/build=. : strip absolute build path from any
#   string the toolchain might embed (panic messages, debug-info leftovers).
# - SOURCE_DATE_EPOCH (passed at docker build time) is honored by maturin
#   1.6+ for wheel mtimes and by rustc since 1.79+ for any embedded date.
ARG SOURCE_DATE_EPOCH=315532800
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV RUSTFLAGS="--remap-path-prefix=/build=."
RUN cargo build --release --locked -p rhorizon-custodian && \
    maturin build --release --locked --strip && \
    pip install --no-cache-dir --prefix=/install target/wheels/*.whl


FROM docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

# OCI labels for Docker Hub / GHCR / Gitea registry display.
# REVISION + CREATED are filled in by the CI build (--build-arg) ;
# default placeholders are kept so a local `docker build` still works.
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="rhorizon-api" \
      org.opencontainers.image.description="Resurgamus Horizon, self-hosted secrets vault. Encrypted at rest, audit-chained, MCP-ready for AI agents." \
      org.opencontainers.image.url="https://github.com/JR-Shdw/Horizon" \
      org.opencontainers.image.source="https://github.com/JR-Shdw/Horizon" \
      org.opencontainers.image.documentation="https://raw.githubusercontent.com/JR-Shdw/Horizon/main/README.md" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="Resurgamus" \
      org.opencontainers.image.authors="shdw <horizon@resurgamus.com>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}"

WORKDIR /app

ARG SOURCE_DATE_EPOCH=315532800
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# CVE-2026-53615, util-linux <= 2.41-5. Debian fixed it in 2.41.5-0+deb13u1,
# but neither python:3.12-slim nor postgres:18-trixie has rebuilt against it
# yet, so the pinned bases still ship the vulnerable set and the CVE gate fails
# on 9 packages per image -- one source package counted once per binary it
# produces.
#
# Versions are pinned rather than left to `apt-get upgrade`: reproducibility.yml
# proves byte-identical rebuilds, which an unpinned upgrade would break the
# moment the archive moves. Two of the nine do NOT follow the source version --
# bsdutils carries epoch 1:, and login is versioned 1:4.16.0-2+really<ver> --
# so they are spelled out rather than derived.
#
# DELETE this whole block once the base image ships >= 2.41.5-0+deb13u1; the
# pinned versions will fail the build when the archive drops them, which is the
# intended reminder.
ARG UTIL_LINUX_VERSION=2.41.5-0+deb13u1

# Runtime only: libsodium + libldap (no -dev, no gcc)
RUN apt-get update && \
    apt-get install -y --no-install-recommends --only-upgrade \
        util-linux=${UTIL_LINUX_VERSION} \
        bsdutils=1:${UTIL_LINUX_VERSION} \
        libblkid1=${UTIL_LINUX_VERSION} \
        liblastlog2-2=${UTIL_LINUX_VERSION} \
        libmount1=${UTIL_LINUX_VERSION} \
        libsmartcols1=${UTIL_LINUX_VERSION} \
        libuuid1=${UTIL_LINUX_VERSION} \
        mount=${UTIL_LINUX_VERSION} \
        login=1:4.16.0-2+really${UTIL_LINUX_VERSION} && \
    apt-get install -y --no-install-recommends libsodium23 libldap2 libsasl2-2 && \
    rm -rf /var/lib/apt/lists/* && \
    # Remove tools an attacker could use
    rm -f /usr/bin/wget /usr/bin/curl 2>/dev/null; \
    pip uninstall -y pip setuptools 2>/dev/null; \
    rm -rf /usr/local/lib/python3.12/ensurepip && \
    # Remove __pycache__ from stdlib to reduce image size
    find /usr/local/lib/python3.12 -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    true

# Copy Python packages from builder
COPY --from=builder /install /usr/local
# Copy Rust extension from rust-builder
COPY --from=rust-builder /install /usr/local
# Packaged for explicit Rust-custody canaries. Standard startup remains
# /app/run-api.sh and does not launch this binary.
COPY --from=rust-builder /build/target/release/rhorizon-custodian /usr/local/bin/rhorizon-custodian

COPY api/app/ ./app/
COPY api/run-api.sh ./run-api.sh
COPY api/run-rust-custodians.sh ./run-rust-custodians.sh
COPY schema.sql ./schema.sql
COPY dynamic-engines.ini ./dynamic-engines.ini

# Non-root user, no login shell, no home directory
RUN useradd -r -u 1500 -s /usr/sbin/nologin -M rhorizon && \
    # App directory: read-only for rhorizon
    chown root:root -R /app && \
    chmod 755 /app && \
    chmod 644 /app/schema.sql && \
    chmod 644 /app/dynamic-engines.ini && \
    chmod 755 /app/run-api.sh /app/run-rust-custodians.sh && \
    find /app/app -type f -exec chmod 644 {} + && \
    find /app/app -type d -exec chmod 755 {} + && \
    # node_uuid volume mountpoint: pre-create with uid 1500 so
    # the named volume inherits ownership on first mount (read_only root
    # FS prevents runtime mkdir at the root path).
    mkdir -p /var/lib/rhorizon && \
    chown 1500:1500 /var/lib/rhorizon && \
    chmod 0700 /var/lib/rhorizon

USER 1500

EXPOSE 8200

ENV RHORIZON_WORKERS=5

# Boot wrapper :
# - RHORIZON_WORKERS=1 is the home preset: a single worker holds the
#   sub-keys in-process, no RPC, no Shamir (single-worker fast-path in
#   cluster_setup). 2..4 is bumped to 5 so the failover quorum (Shamir
#   threshold 3 of 5) has a master + 4 followers worth of share-holders;
#   5+ is the multi-worker cluster (smb/heavy presets).
# - Explicit `--http httptools --loop uvloop` :
#   `uvicorn[standard]` ships httptools + uvloop as deps, but
#   without explicit flags uvicorn silently falls back to h11 / asyncio
#   if either import fails. The explicit form is fail-fast, if a wheel
#   regression breaks the import, the container fails to boot loud
#   instead of running 50 % slower in silent regression.
# - HTTP/1.1 keep-alive tuning (Sprint D), bench c=500 surfaced
#   RemoteProtocolError on ~0.03 % of requests, signature of an
#   HTTP/1.1 keep-alive race : default --timeout-keep-alive=5s closes
#   idle conns under the bench client's reuse window. Bumping to 30s
#   collapses the race window 6× ; combined with nginx upstream
#   keepalive_timeout 25s (frontend/nginx-tls.conf) nginx always
#   recycles upstream conns BEFORE uvicorn closes them, eliminating
#   the cross-side close race entirely.
# - --backlog 4096 matches host net.core.somaxconn so kernel listen
#   queue never silently drops SYN under burst.
# - --limit-concurrency 250 caps in-flight requests per worker. With
#   5 workers, system capacity = 1250 ; at c=500 bench, headroom is
#   2.5× before any 503. Explicit overload semantics (clean 503
#   instead of mystery transport drops) is operationally clearer.
CMD ["/app/run-api.sh"]
