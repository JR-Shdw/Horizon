# =============================================================================
# Resurgamus Horizon -- native install config
#
# Copy to /etc/rhorizon/rhorizon.env (root-owned, mode 0600 -- it holds the DB
# password), then load it from the systemd unit via `EnvironmentFile=`. Values
# shown are the defaults; uncomment + change only what you need.
#
#   sudo install -d -o root -g root -m 0755 /etc/rhorizon
#   sudo install -m 0600 examples/rhorizon.env.example /etc/rhorizon/rhorizon.env
#
# Full variable reference: docs/docs/reference/env-vars.md
# Compose deployments use env.example instead (this file is for native/systemd).
# =============================================================================

# --- Database ----------------------------------------------------------------
# asyncpg DSN to your local PostgreSQL 18. Use a long random password.
RH_DATABASE_URL=postgresql+asyncpg://rhorizon:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/rhorizon
# TLS to PG: disable | require | verify-full. 'false'/'disable' is fine over a
# loopback unix socket on a single host; use verify-full across a network.
RH_DATABASE_SSL=false
# RH_DATABASE_CA_CERT=/etc/rhorizon/pg-ca.crt   # only with verify-full

# --- Vault / seal ------------------------------------------------------------
# Auto-seal after N minutes idle (0 = never; recommended for cron-driven hosts).
RH_AUTO_SEAL_MINUTES=0
# Stale-alert threshold for the dek_key (informational; rotation is automatic).
RH_DEK_KEY_MAX_AGE_DAYS=30

# --- Audit -------------------------------------------------------------------
RH_AUDIT_DIR=/var/log/rhorizon
RH_AUDIT_RETENTION_DAYS=365          # minimum before a file may be deleted (365-3650)
RH_AUDIT_COMPRESS_DAYS=1             # gzip files older than N days (1..retention)
# fail2ban-ready failed-auth log (see docs/FAIL2BAN.md).
RH_AUTHFAIL_LOG=/var/log/rhorizon/authfail.log

# --- Request size limits -----------------------------------------------------
RH_MAX_BODY_BYTES=1048576            # 1 MB  -- all API endpoints
RH_MAX_BODY_BACKUP=104857600         # 100 MB -- /backup/restore only

# --- Network / reverse proxy -------------------------------------------------
# Only meaningful behind a reverse proxy: CSV of trusted upstream CIDRs, used
# for X-Forwarded-For client-IP recovery (audit) and SSO header trust. Keep it
# tight; the loopback default assumes no proxy.
RH_PROXY_TRUSTED_IPS=127.0.0.0/8,::1/128
# SSO proxy auth (Authelia / Authentik / Keycloak) -- opt-in:
# RH_PROXY_AUTH_ENABLED=true
# RH_PROXY_USER_HEADER=Remote-User
# RH_PROXY_GROUPS_HEADER=Remote-Groups

# --- Metrics (Prometheus) ----------------------------------------------------
RH_METRICS_ENABLED=true
# IP-allowlist for /metrics (trust = perimeter, X-Forwarded-For is ignored).
RH_METRICS_ALLOWED_CIDRS=127.0.0.1/32

# --- Workers (single-host multi-worker; see docs/multiworker.md) -------------
# N uvicorn workers: one master holds the keys, the rest delegate crypto over a
# Unix socket. Floored to 5 by the boot wrapper (failover quorum needs 3 of 5).
RH_WORKERS=5
# Shamir share distribution. 0 = auto-derive (total=max(5,WORKERS),
# threshold=majority). Override only for an asymmetric quorum need.
# RH_CLUSTER_SHAMIR_TOTAL=0
# RH_CLUSTER_SHAMIR_THRESHOLD=0

# --- Multi-host HA (off for a single-host install; see docs/HA-CLUSTER.md) ---
RH_CLUSTER_ENABLED=false
